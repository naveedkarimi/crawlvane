# Copy to .env.local (development) or .env (server) and fill in. Optional settings are
# commented out: leave them that way unless you need them, because a blank number means 0.

# ---- Site. NEXT_PUBLIC_ values are read at build time and sent to browsers. ----
NEXT_PUBLIC_SITE_URL=https://crawlvane.com
NEXT_PUBLIC_APP_NAME=Crawlvane

# Shown on the privacy and terms pages. The privacy policy needs these before launch.
# NEXT_PUBLIC_LEGAL_NAME=Your Company Ltd
# NEXT_PUBLIC_LEGAL_ADDRESS=Street, City, Country
# NEXT_PUBLIC_PRIVACY_EMAIL=privacy@crawlvane.com

# ---- Security. Use long random values. ----
ADMIN_KEY=
CRON_SECRET=

# ---- Supabase (required: all data is stored here). Run supabase/schema.sql first. ----
# Server only. The service_role key has full access: never add NEXT_PUBLIC_ to it.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Forms that go straight from the browser. Public (anon) key only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- APIs (server only) ----
PAGESPEED_API_KEY=
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# PERPLEXITY_API_KEY=
# GEMINI_API_KEY=
# BROWSERLESS_URL=

# ---- Email (for monitoring alerts) ----
# SMTP_HOST=mail.yourdomain.com
# SMTP_PORT=465
# SMTP_USER=alerts@yourdomain.com
# SMTP_PASS=
# MAIL_FROM="Crawlvane <alerts@yourdomain.com>"

# ---- Analytics ----
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=crawlvane.com
# NEXT_PUBLIC_PLAUSIBLE_SRC=

# ---- Features. Set to 1 to switch one on for everyone. ----
# PAYWALL_ENABLED=
# FEATURE_AI_VISIBILITY=1
# FEATURE_DEEP_RESEARCH=1
# FEATURE_MONITORING=1
# FEATURE_SOCIAL_POSTS=1
# FEATURE_WHITE_LABEL=1
# FEATURE_JS_RENDER=1
# FEATURE_ACCOUNTS=1

# ---- AI models and cost controls ----
# AI_DAILY_TOKEN_CAP=
# ANTHROPIC_MODEL=
# ANTHROPIC_WEB_SEARCH_TOOL=
# OPENAI_MODEL=
# OPENAI_WEB_SEARCH_TOOL=
# PERPLEXITY_MODEL=
# GEMINI_MODEL=
# Prices in US dollars per million tokens, or per 1,000 web searches.
# AI_PRICE_ANTHROPIC_IN=
# AI_PRICE_ANTHROPIC_OUT=
# AI_PRICE_ANTHROPIC_SEARCH=

# ---- Limits (defaults shown) ----
# MAX_PAGES_DEFAULT=50
# MAX_PAGES_HARD=300
# CRAWL_CONCURRENCY=2
# CRAWL_DELAY_MS=500
# MAX_CONCURRENT_JOBS=2
# REPORTS_PER_HOUR=5
# REPORT_TTL_DAYS=30
# RATE_LIMIT_PER_HOUR=
# TOOL_PER_HOUR=40
# WIDGET_PER_HOUR=10
# BOT_TEST_PER_HOUR=
# LLMS_TOOL_PER_HOUR=

