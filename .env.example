# Copy to .env.local (development) or .env (server) and fill in. Optional settings are
# commented out: leave them that way unless you need them, because a blank number means 0.

# ---- Site. NEXT_PUBLIC_ values are read at build time and sent to browsers. ----
NEXT_PUBLIC_SITE_URL=https://crawlvane.com
NEXT_PUBLIC_APP_NAME=Crawlvane

# The app on its own address. Leave unset to run everything on one address (as in development).
# With it set, /dashboard, /login and /invite move to this address and the rest stays on the site.
# NEXT_PUBLIC_APP_URL=https://app.crawlvane.com
# Share the sign-in cookie between both addresses, so the site's header knows you're signed in.
# NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=.crawlvane.com
# Sign-in buttons. Switch each provider on in Supabase (Authentication → Providers) first, or the button can't work.
# NEXT_PUBLIC_AUTH_GOOGLE=1
# Microsoft is called "Azure" in Supabase. Use the "common" tenant so personal and work accounts both work.
# NEXT_PUBLIC_AUTH_MICROSOFT=1
# NEXT_PUBLIC_AUTH_GITHUB=1

# Shown on the privacy and terms pages. The privacy policy needs these before launch.
# NEXT_PUBLIC_LEGAL_NAME=Your Company Ltd
# NEXT_PUBLIC_LEGAL_ADDRESS=Street, City, Country
# NEXT_PUBLIC_PRIVACY_EMAIL=privacy@crawlvane.com

# ---- Security. Use long random values. ----
ADMIN_KEY=
CRON_SECRET=

# ---- Supabase (required: all data is stored here). Run supabase/schema.sql first. ----
# Server only. The service_role key has full access: never add NEXT_PUBLIC_ to it.
# Set each setting once. A second, empty line for the same setting later in the file wipes out the value.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Forms that go straight from the browser. Public (anon) key only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Payments (Stripe). Create the products and prices in Stripe, then paste their price IDs. ----
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_AGENCY=
# Optional yearly prices (a discount for paying a year up front).
# STRIPE_PRICE_PRO_YEARLY=
# STRIPE_PRICE_AGENCY_YEARLY=
# Free trial for a team's first Pro or Agency subscription, in days (0 = none, max 60).
# STRIPE_TRIAL_DAYS=14
# STRIPE_PRICE_REPORT=
# Price shown on the page check for buying one full report before signing in (needs STRIPE_PRICE_REPORT and the paywall).
# PRICE_REPORT_LABEL=$39
# STRIPE_PRICE_CREDITS=
# CREDITS_PER_PACK=100
# Agency add-ons: recurring monthly prices in Stripe, added to the Agency subscription as extra items.
# STRIPE_PRICE_EXTRA_SEAT=
# STRIPE_PRICE_EXTRA_SITES=
# Labels shown in the dashboard (the real amounts come from Stripe). Each site pack adds 10 sites.
# PRICE_EXTRA_SEAT_LABEL=$10 a month
# PRICE_EXTRA_SITES_LABEL=$20 a month
# The webhook (YOUR_DOMAIN/api/billing/webhook) needs: checkout.session.completed and
# customer.subscription.created, .updated, .deleted and .trial_will_end (for the trial-ending email).
# Turn on plan limits and paid features once payments work.
# PAYWALL_ENABLED=1
# Prices shown on /pricing. Paid plans appear there only when the paywall is on and both are set.
# PRICE_PRO_LABEL=$39
# PRICE_AGENCY_LABEL=$99
# PRICE_PRO_YEARLY_LABEL=$390
# PRICE_AGENCY_YEARLY_LABEL=$990

# ---- Sign-up gate: visitors get the basics, a free account unlocks the rest ----
# Without an account: scores, every issue, and how to fix the first few. With a free account:
# every fix, the AI fix plan, downloads and full site reports. Needs FEATURE_ACCOUNTS=1.
# SIGNUP_GATE=1
# VISITOR_FIX_PREVIEW=3

# ---- APIs (server only) ----
PAGESPEED_API_KEY=
ANTHROPIC_API_KEY=
# Google Play data for the app store checker (serpapi.com). Without it only App Store checks work.
# SERPAPI_KEY=
# OPENAI_API_KEY=
# PERPLEXITY_API_KEY=
# GEMINI_API_KEY=
# BROWSERLESS_URL=

# ---- Email (for monitoring alerts) ----
# SMTP_HOST=mail.yourdomain.com
# SMTP_PORT=465
# SMTP_USER=alerts@yourdomain.com
# SMTP_PASS=
# MAIL_FROM="Crawlvane <alerts@yourdomain.com>"

# ---- Analytics ----
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=crawlvane.com
# NEXT_PUBLIC_PLAUSIBLE_SRC=

# ---- Features. Set to 1 to switch one on for everyone. ----
# FEATURE_AI_VISIBILITY=1
# FEATURE_DEEP_RESEARCH=1
# FEATURE_MONITORING=1
# FEATURE_SOCIAL_POSTS=1
# FEATURE_WHITE_LABEL=1
# FEATURE_JS_RENDER=1
# FEATURE_ACCOUNTS=1
# FEATURE_APP_PREMIUM=1
# Let agencies serve reports on their own domain (reports.agency.com). Each domain also has
# to be added to your hosting, with an SSL certificate, before it works.
# CUSTOM_REPORT_DOMAINS=1

# ---- AI models and cost controls ----
# AI_DAILY_TOKEN_CAP=
# ANTHROPIC_MODEL=
# ANTHROPIC_WEB_SEARCH_TOOL=
# OPENAI_MODEL=
# OPENAI_WEB_SEARCH_TOOL=
# PERPLEXITY_MODEL=
# GEMINI_MODEL=
# Prices in US dollars per million tokens, or per 1,000 web searches.
# AI_PRICE_ANTHROPIC_IN=
# AI_PRICE_ANTHROPIC_OUT=
# AI_PRICE_ANTHROPIC_SEARCH=

# ---- Limits (defaults shown) ----
# MAX_PAGES_DEFAULT=50
# MAX_PAGES_HARD=300
# CRAWL_CONCURRENCY=2
# CRAWL_DELAY_MS=500
# MAX_CONCURRENT_JOBS=2
# REPORTS_PER_HOUR=5
# REPORT_TTL_DAYS=30
# PAID_REPORT_TTL_DAYS=365
# RATE_LIMIT_PER_HOUR=
# TOOL_PER_HOUR=40
# WIDGET_PER_HOUR=10
# BOT_TEST_PER_HOUR=
# LLMS_TOOL_PER_HOUR=
# APP_CHECKS_PER_HOUR=20

# ---- Google Search Console and GA4 (read-only, per team) ----
# Google Cloud → APIs & Services: enable "Google Search Console API", "Google Analytics Data API" and
# "Google Analytics Admin API", create an OAuth "Web application" client, and add the redirect URI
# https://YOUR_APP_DOMAIN/api/me/google/callback (and http://localhost:3000/api/me/google/callback for testing).
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# Encrypts the stored Google tokens. Any long random string; changing it disconnects every team.
# TOKEN_ENCRYPTION_KEY=

# ---- AI helpers and AI free tools (need ANTHROPIC_API_KEY) ----
# On by default once the Anthropic key is set. Set to 0 to hide them.
# FEATURE_AI_HELPERS=1
# FEATURE_AI_TOOLS=1
# Most AI free-tool runs per day across all visitors (a cost ceiling). Default 150.
# AI_TOOLS_DAILY_CAP=150
